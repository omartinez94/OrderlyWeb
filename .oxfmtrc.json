{
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "insertFinalNewline": true,
  "sortTailwindcss": true,
  "ignorePatterns": [".agents", ".harness", ".claude/skills", "docs/wireframes", "pnpm-lock.yaml"]
}
